<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.4" snapToGrid="true">
  <code><![CDATA[extensions [ nw ]

globals [
  num-intra-links
  
  interaction-count
  c-created?
  first-c-time
  outcome
]

turtles-own
[
  inventory
]

breed [speakers-a speaker-a]
breed [speakers-b speaker-b]

to setup
  clear-all
  ask patches [ set pcolor white ]
  set c-created? false
  set outcome "running"
  random-seed graph-seed
  set-default-shape turtles "person"
  set num-intra-links (1500 - bridges) / 2
  create-speakers-a 150 [ set inventory["A"] set color [190 190 0] setxy (random-float min-pxcor) random-ycor ]
  create-speakers-b 150 [ set inventory["B"] set color [36 94 175]  setxy (random-float max-pxcor) random-ycor ]
  
  ; just in case the setup creates a network with an odd output
  let expected-setup ifelse-value (bridges = 0) [2] [1]
  let valid-network? false
  while [not valid-network?] [
    clear-links
    connect-speakers-a
    connect-speakers-b
    bridge-communities
    set valid-network? (length nw:weak-component-clusters = expected-setup)
  ]
  
  ; make the network look a little prettier
  ask links [ set color [220 220 220] ]
  ask links with [ [breed] of end1 != [breed] of end2 ] [
    set color black
    set thickness 0.05
  ]
  repeat 10
  [
    layout-spring turtles links 0.3 (world-width / (sqrt count turtles)) 1
  ]
  random-seed run-seed
  reset-ticks
end

to connect-speakers-a
  while [count links < num-intra-links]
  [
    ask one-of turtles with [breed = speakers-a]
    [
      let choice one-of other turtles with [breed = speakers-a]
      if choice != nobody [ create-link-with choice ]
    ]
  ]
end

to connect-speakers-b
  while [count links < num-intra-links * 2]
  [
    ask one-of turtles with [breed = speakers-b]
    [
      let choice one-of other turtles with [breed = speakers-b]
      if choice != nobody [ create-link-with choice ]
    ]
  ]
end

to bridge-communities
  while [count links < 1500 ]
  [
    ask one-of turtles
    [
      let choice one-of turtles with [breed != [breed] of myself]
      if choice != nobody [ create-link-with choice ]
    ]
  ]
end

to create-interaction
  set interaction-count interaction-count + 1
  
  ; randomly choose a turtle and define it as the speaker
  let role-speaker one-of turtles
  ; randomly choose a speaker's neighbour to be the hearer
  let role-hearer one-of [link-neighbors] of role-speaker
  ; if speaker knows both A and B create C (and drop A and B), with probability gamma
  if random-float 1 < gamma [
    ask role-speaker [
      if member? "A" inventory and member? "B" inventory [ set inventory ["C"]
        if not c-created? [
          set c-created? true
          set first-c-time interaction-count / count turtles
        ]
      ]
    ]
  ]
  
  ; randomly define the chosen word (chosen label) from speaker's inventory
  let chosen-word one-of [inventory] of role-speaker
  
  ifelse member? chosen-word [inventory] of role-hearer
  [
    ; the hearer knows the chosen word (chosen label), and the others are dropped with probability beta
    if random-float 1 < beta [
      ask role-speaker [ set inventory (list chosen-word) ]
      ask role-hearer [ set inventory (list chosen-word) ]
    ]
  ]
  [
    ; if the word is not in hearer's inventory, it adds it
    ask role-hearer [ set inventory lput chosen-word inventory ]
  ]
end

to go
  if outcome != "running" [ stop ]
  
  repeat count turtles [ create-interaction ]
  ask turtles [
    let s sort inventory
    if s = ["A"]         [ set color [190 190 0] ]
    if s = ["B"]         [ set color [36 94 175] ]
    if s = ["C"]         [ set color [0 217 215] ]
    if s = ["A" "B"]     [ set color [78 184 68] ]
    if s = ["A" "C"]     [ set color [255 93 0] ]
    if s = ["B" "C"]     [ set color [154 52 194] ]
    if s = ["A" "B" "C"] [ set color [201 32 132] ]
  ]
  tick
  
  if all? turtles [inventory = ["A"]] or all? turtles [inventory = ["B"]] or all? turtles [inventory = ["C"]]
    [ set outcome first [inventory] of one-of turtles 
  ]
  
  if outcome = "running" and ticks >= horizon [
    set outcome "unresolved"
  ]
end]]></code>
  <widgets>
    <view x="270" wrappingAllowedX="false" y="7" frameRate="30.0" minPycor="-20" height="660" showTickCounter="true" patchSize="16.0" fontSize="10" wrappingAllowedY="false" width="660" tickCounterLabel="ticks" maxPycor="20" updateMode="1" maxPxcor="20" minPxcor="-20"></view>
    <slider x="10" step="0.05" y="75" max="1" width="250" display="gamma" height="50" min="0" direction="Horizontal" default="0.5" variable="gamma"></slider>
    <slider x="10" step="0.05" y="130" max="1" width="250" display="beta" height="50" min="0" direction="Horizontal" default="0.3" variable="beta"></slider>
    <input x="10" multiline="false" y="185" height="60" variable="horizon" type="number" width="250">100000.0</input>
    <input x="130" multiline="false" y="250" height="60" variable="run-seed" type="number" width="130">5.0</input>
    <input x="10" multiline="false" y="250" height="60" variable="graph-seed" type="number" width="115">1.0</input>
    <button x="10" y="365" height="45" disableUntilTicks="true" forever="true" kind="Observer" width="250">go</button>
    <chooser x="10" y="10" height="60" variable="bridges" current="5" width="250" display="bridges">
      <choice type="double" value="0.0"></choice>
      <choice type="double" value="2.0"></choice>
      <choice type="double" value="10.0"></choice>
      <choice type="double" value="50.0"></choice>
      <choice type="double" value="70.0"></choice>
      <choice type="double" value="100.0"></choice>
      <choice type="double" value="150.0"></choice>
      <choice type="double" value="200.0"></choice>
      <choice type="double" value="750.0"></choice>
    </chooser>
    <plot x="730" autoPlotX="false" yMax="300.0" autoPlotY="false" y="5" xMin="0.0" height="465" legend="true" xMax="7.0" yMin="0.0" width="230" display="Inventory types">
